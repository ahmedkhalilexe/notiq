{
  "name": "notiq-worker",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "lint": "bunx biome lint",
    "lint:write": "bunx biome lint --write",
    "format": "bunx biome format",
    "format:write": "bunx biome format --write",
    "check": "bunx biome check",
    "check:write": "bunx biome check --write",
    "ci": "bunx biome ci",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun test",
    "build": "docker build -t notiq-worker ."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@biomejs/biome": "2.6.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "amqplib": "^2.0.1",
    "knex": "^3.2.10",
    "pg": "^8.22.0"
  }
}
